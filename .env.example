# Public Supabase configuration. Copy this file to .env.local and replace the placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Canonical application origin used in authentication emails. Vercel preview
# deployments fall back to VERCEL_URL automatically; local development falls
# back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Billing (server-only). Configure these only in the deployment environment;
# never expose them to the browser or commit real values.
BILLING_PROVIDER=stripe
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_WEBHOOK_SECRET=
BILLING_STRIPE_PRO_PRICE_ID=
SUPABASE_SERVICE_ROLE_KEY=
