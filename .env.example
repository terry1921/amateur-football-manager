# Public Supabase configuration. Copy this file to .env.local and replace the placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Canonical application origin used in authentication emails. Vercel preview
# deployments fall back to VERCEL_URL automatically; local development falls
# back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DB_PASS=bd_password
